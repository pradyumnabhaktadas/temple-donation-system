# Copy this file to .env and fill in your real values, then restart the app.
# The app runs in DEMO MODE (simulated payments) until RAZORPAY_KEY_ID and
# RAZORPAY_KEY_SECRET are both set.

SECRET_KEY=change-this-to-a-long-random-string

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

ORG_NAME=Sri Sri Radha Krishna Temple
ORG_ADDRESS=Temple Address, City, State, PIN
ORG_PAN=AAAAA0000A
ORG_80G_REG_NO=AAAAA0000A-XXXXX

# DATABASE_URL=postgresql://user:pass@host:5432/temple_donations

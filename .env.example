# Copy this file to .env and fill in your real values, then restart the app.
# The app runs in DEMO MODE (simulated payments) until RAZORPAY_KEY_ID and
# RAZORPAY_KEY_SECRET are both set.

SECRET_KEY=change-this-to-a-long-random-string

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

ORG_NAME=Sri Sri Radha Krishna Temple
ORG_ADDRESS=Temple Address, City, State, PIN
ORG_PAN=AAAAA0000A
ORG_80G_REG_NO=AAAAA0000A-XXXXX

# Public website footer (About Us / Located On / Contact Us) -- separate
# from ORG_ADDRESS/ORG_EMAIL above, which feed the legal 80G receipt text.
ORG_ABOUT_TEXT=A short 2-3 sentence description of the temple/organisation for the website footer.
ORG_CONTACT_ADDRESS=Temple Address, City, State, PIN
ORG_CONTACT_EMAIL=contact@example.org
# Shown in the footer/About page as click-to-call and click-to-WhatsApp.
ORG_CONTACT_PHONE=+91 93156 22933

# DATABASE_URL=postgresql://user:pass@host:5432/temple_donations

# Receipts are emailed/WhatsApp'd to donors automatically once these are
# set -- see README "Emailing receipts" / "Sending receipts via WhatsApp".
# SMTP_HOST=smtp.gmail.com
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# WHATSAPP_AIRTEL_USERNAME=
# WHATSAPP_AIRTEL_PASSWORD=
# WHATSAPP_FROM_NUMBER=
# WHATSAPP_TEMPLATE_ID=
# PUBLIC_BASE_URL=https://givetokrishna.com

# Weekly data backup (backup_data.py / the temple-weekly-backup Cron Job in
# render.yaml) -- emails a ZIP of donors/donations/lookup lists as CSV.
# Falls back to ORG_CONTACT_EMAIL above if left blank. Needs SMTP_HOST etc.
# (above) configured too, or the backup is saved locally only, not emailed.
# BACKUP_EMAIL=backups@example.org
# BACKUP_RETENTION_COUNT=12
